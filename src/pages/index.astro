---
import Base from "../layouts/Base.astro";
---

<Base>
  <div class="wrap">
    <div class="hero">
      <div>
        <div class="hero__tour">Kickstart Marketing Agency · World Growth Tour</div>
        <h1 class="hero__h1">
          Marketing<br />that <span class="out">delivers</span><br />results.
        </h1>
        <p class="hero__p">
          Helping businesses, brands, and sports organizations grow through creative
          digital marketing and innovative strategies. Your brand, headlining.
        </p>
        <div class="hero__btns">
          <a class="btn btn--gold" href="https://wa.me/2348064797494" target="_blank" rel="noopener">WhatsApp Us</a>
          <a class="btn btn--line" href="/contact">Request a quote</a>
        </div>
      </div>
      <div class="vinyl-wrap" aria-hidden="true">
        <div class="vinyl"><span class="vinyl__label">KMA</span></div>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><div class="stat__n">15</div><div class="stat__l">Academies signed</div></div>
      <div class="stat"><div class="stat__n">4</div><div class="stat__l">Partnerships secured</div></div>
      <div class="stat"><div class="stat__n">12</div><div class="stat__l">Services on the setlist</div></div>
      <div class="stat"><div class="stat__n">1</div><div class="stat__l">Goal — your growth</div></div>
    </div>

    <section style="padding-top:0">
      <div class="eyebrow">Headline act</div>
      <h2>SportyKore went <span class="g">platinum.</span></h2>
      <p class="sub">Our flagship sports engagement — launch marketing and academy outreach for a grassroots soccer league management platform built for football communities across Africa.</p>
      <div class="record-case">
        <div class="mini-vinyl" aria-hidden="true"></div>
        <div>
          <div class="plat">★ Certified growth record</div>
          <h3>
            <img src="/logo.jpeg" alt="SportyKore logo" width="42" height="42" />
            SportyKore
          </h3>
          <p>KMA built the positioning, produced academy-facing content, ran direct outreach campaigns, and secured partnerships — turning a new platform into an active league network across the football community.</p>
          <div class="rstats">
            <div><div class="rs__n">15</div><div class="rs__l">Academies onboarded</div></div>
            <div><div class="rs__n">4</div><div class="rs__l">Partnerships secured</div></div>
            <div><div class="rs__n">↑</div><div class="rs__l">Leagues growing weekly</div></div>
          </div>
          <div style="margin-top:22px"><a class="btn btn--line" href="/work">Full case study</a></div>
        </div>
      </div>
      <div class="gallery">
        <div class="gallery__item"><img src="/onboarding.png" alt="SportyKore onboarding" loading="lazy" /><div class="gallery__cap">Onboarding</div></div>
        <div class="gallery__item"><img src="/match-center.png" alt="SportyKore live match center" loading="lazy" /><div class="gallery__cap">Match Center</div></div>
        <div class="gallery__item"><img src="/manage-leagues.png" alt="SportyKore league management" loading="lazy" /><div class="gallery__cap">League Mgmt</div></div>
        <div class="gallery__item"><img src="/player-profile.png" alt="SportyKore player profile" loading="lazy" /><div class="gallery__cap">Player Profile</div></div>
      </div>
    </section>
  </div>
</Base>
