---
import Base from "../layouts/Base.astro";
---
<Base title="Work — KMA Kickstart Marketing Agency">
  <div class="wrap">
    <section>
      <div class="eyebrow">The records wall</div>
      <h2>Certified <span class="g">results.</span></h2>
      <p class="sub">Case studies that went gold — starting with our headline release, SportyKore.</p>

      <div class="record-case" style="margin-bottom:32px">
        <div class="mini-vinyl" aria-hidden="true"></div>
        <div>
          <div class="plat">Case Study 001 · Sports Marketing</div>
          <h3>
            <img src="/logo.jpeg" alt="SportyKore logo" width="42" height="42" />
            SportyKore
          </h3>
          <p><strong style="color:#fff">The brief:</strong> take a brand-new grassroots soccer league management platform to the academies who needed it — and convert interest into active, running leagues.</p>
          <p><strong style="color:#fff">The performance:</strong> KMA built the positioning and messaging, created academy-facing content, ran direct outreach campaigns, and developed partnerships with football organizations across the community.</p>
          <p><strong style="color:#fff">The encore:</strong> 15 academies onboarded and 4 partnerships secured, with leagues running real fixtures week after week on the platform.</p>
          <div class="rstats">
            <div><div class="rs__n">15</div><div class="rs__l">Academies signed</div></div>
            <div><div class="rs__n">4</div><div class="rs__l">Partnerships</div></div>
            <div><div class="rs__n">↑</div><div class="rs__l">Active leagues</div></div>
          </div>
        </div>
      </div>

      <div class="gallery">
        <div class="gallery__item"><img src="/onboarding.png" alt="SportyKore onboarding" loading="lazy" /><div class="gallery__cap">Onboarding</div></div>
        <div class="gallery__item"><img src="/match-center.png" alt="Live match center" loading="lazy" /><div class="gallery__cap">Match Center</div></div>
        <div class="gallery__item"><img src="/manage-leagues.png" alt="League management" loading="lazy" /><div class="gallery__cap">League Mgmt</div></div>
        <div class="gallery__item"><img src="/player-profile.png" alt="Player profile" loading="lazy" /><div class="gallery__cap">Player Profile</div></div>
      </div>

      <div class="stats" style="margin-top:32px;padding-bottom:0">
        <div class="stat"><div class="stat__n">＋</div><div class="stat__l">Testimonials coming soon</div></div>
        <div class="stat"><div class="stat__n">＋</div><div class="stat__l">Client logos coming soon</div></div>
        <div class="stat"><div class="stat__n">＋</div><div class="stat__l">Blog coming soon</div></div>
      </div>
    </section>
  </div>
</Base>
